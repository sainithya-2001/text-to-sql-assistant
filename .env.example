# Copy to .env and fill in. .env is gitignored.

# Required for generating SQL (tests don't need it)
ANTHROPIC_API_KEY=

# Optional overrides
# T2S_MODEL=claude-sonnet-5-5        # or claude-haiku-5-5
# T2S_EFFORT=low
# T2S_MAX_ROWS=200
# T2S_TIMEOUT_S=15
# T2S_TOP_K=4
# T2S_EMBEDDER=fastembed             # or hash (offline, lower quality)
# T2S_TPCH_SCALE=0.01

# Optional Snowflake backend (SNOWFLAKE_SAMPLE_DATA.TPCH_SF1). Off unless all four are set
# and T2S_BACKEND=snowflake. Needs: pip install -e ".[snowflake]"
# T2S_BACKEND=snowflake
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_ROLE=
